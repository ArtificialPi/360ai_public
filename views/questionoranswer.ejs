<!DOCTYPE html>
<html>
    <head>
        <title>
            360AI
        </title>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/my_qora_style">
        <link rel="icon" href="/favicon.ico" type="image/png">
    </head>
    <body>
        <div id="wholePage">
            <img src="favicon.ico" style="width:200px;margin:25px auto 0 auto;">
            <div style="max-width: calc( 100% - 10px );width:1920px;border: none;text-align:right;">v0.0.1</div>
            <hr style="border:solid 1px rgba(102, 153, 255, 0.5);width:1920px;margin:25px 0 0 0;">
            <div id="qoraContainer">
                <div id="navigationMainMenu">
                    <a href="/profile" class="navigationButton">Profile</a><a href="/search" class="navigationButton">Search</a><div class="navigationButton" >Open Field</div><a href='/options' class="navigationButton" >Options</a><div class="navigationButton" style="display:none;" id="searchAnchor"><input  style="width:200px;text-align: center;color: rgba(102, 153, 255,1);border:solid 1px rgba(102, 153, 255,1);outline: none;" value="" id="searchQoraField"></div><div class="navigationButton" style="display:none" id="sortAnchor" onClick="clickSort();"><div id="sortType">Sort: Old</div></div><div style="flex-direction: row;display:none;" id="pageNumber" class="navigationButton"></div>
                </div>
            </div>
            <hr style="border:solid 1px rgba(102, 153, 255, 0.5);width:1920px;margin:0 0 0 0;">
            <div style="display:flex;flex-wrap:wrap;flex-direction:row;justify-content:center;align-items:center;width:1920px;margin:0 0 0 0;"><div id="posta" style="" onClick="QuestionAnswer('answer');">Post Answer</div><div id="postq" style="" onClick="QuestionAnswer('question');">Post Question</div></div>
            <div id="qoraFeed" style="margin:0 0 0 0;max-width: 100%;">
            </div>
        </div>
        <div id="footer">Copyright 360AI &copy; All Rights Reserved.</div>
        <script>
			let allQora=[];
            let searchAllQora=[];
            let pageLimit=50;
            let page=1;
            let sectionAmount=5;
            let initialLoad=0;
            let inputField = document.getElementById('searchQoraField');
            
            init();
            
            //This loads initializes everything including adding search, sort, and pagination
            async function init() {
                allQora = await loadQora();
                if(allQora.length>0) {
					document.getElementById("searchAnchor").style.display="flex";
					document.getElementById("sortAnchor").style.display="flex";
					document.getElementById("pageNumber").style.display="flex";
				}
                pageChange(page);
            }
            
			//Directs client to chat.ejs but under question or answer context in url
            async function QuestionAnswer(qoraType, chatGroupId) {
                let qoraJoinChat=[qoraType, false, chatGroupId];
                const response = await fetch("/requestProcessing", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ qoraJoinChat }),
                });
                if(response.ok) {
                    if(qoraType=='question') {
                        window.location.href = '/question';
                    } else {
                        window.location.href = '/answer';
                    }
                }
            }
            
            //This loads all questions and answers
            async function loadQora() {
                const response = await fetch("/requestProcessing", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ loadQora:true }),
                });
                if(response.ok) {
                    const result = await response.json();
                    qoraResult = result.qoraResult || [];
                    return qoraResult;
                }
            }
            
            //This is the HTML graphics for each question or answer to DOM
            async function loadQoraFront() {
                let questionAnswerScript='';
                if(inputField.value === '') {
                    let start= page*pageLimit-pageLimit;
                    let end = Math.min(page*pageLimit, allQora.length);
                    for(i=start;i<end;i++) {
                        if(allQora[i].qoraType=="question") {
                            questionAnswerScript=questionAnswerScript+'<div onClick="QuestionAnswer(\''+allQora[i].qoraType+'\', \''+allQora[i].chatGroupId+'\')" id="Chat-\''+allQora[i].chatGroupId+'\'" style="" class="questions"><div style="margin: 0 0 0 0;font-size:40px;text-decoration:underline;">Question</div><div style="margin: 25px 0 0 0;font-size:20px;">Username: <div style="color: rgb(0, 51, 0,0.75);">'+allQora[i].username.username+'</div></div><div style="margin: 25px 0 0 0;font-size:20px;">Membership Number: <div style="color: rgb(0, 51, 0,0.75);">'+allQora[i].firstMessage.membershipNumber+'</div></div><div style="margin: 25px 0 0 0;font-size:20px;">Message: <div style="color: rgb(0, 51, 0,0.75);">'+allQora[i].firstMessage.message+'</div><div style="margin: 12.5px 0 0 0;top:0;left:30px;position:absolute;font-size:20px;" onclick="event.stopPropagation();">Report</div></div></div>';
                        } else if(allQora[i].qoraType=="answer") {
                            questionAnswerScript=questionAnswerScript+'<div onClick="QuestionAnswer(\''+allQora[i].qoraType+'\', \''+allQora[i].chatGroupId+'\')" id="Chat-\''+allQora[i].chatGroupId+'\'" style="" class="answers"><div style="margin: 0 0 0 0;font-size:40px;text-decoration:underline;">Answer</div><div style="margin: 25px 0 0 0;font-size:20px;">Username: <div style="color: rgb(0, 51, 0,0.75);">'+allQora[i].username.username+'</div></div><div style="margin: 25px 0 0 0;font-size:20px;">Membership Number: <div style="color: rgb(0, 51, 0,0.75);">'+allQora[i].firstMessage.membershipNumber+'</div></div><div style="margin: 25px 0 0 0;font-size:20px;">Message: <div style="color: rgb(0, 51, 0,0.75);">'+allQora[i].firstMessage.message+'</div></div><div id="votes" style="">Votes<div style="color: rgb(0, 51, 0,0.75);">? / ?</div></div><div style="margin: 12.5px 0 0 0;top:0;left:12.5px;position:absolute;font-size:20px;" onclick="event.stopPropagation();">Report</div></div></div>';
                        }
                    }
                } else {
                   let start= page*pageLimit-pageLimit;
                    let end = Math.min(page*pageLimit, searchAllQora.length);
                    for(i=start;i<end;i++) {
                        if(searchAllQora[i].qoraType=="question") {
                            questionAnswerScript=questionAnswerScript+'<div onClick="QuestionAnswer(\''+searchAllQora[i].qoraType+'\', \''+searchAllQora[i].chatGroupId+'\')" id="Chat-\''+searchAllQora[i].chatGroupId+'\'" style="" class="questions"><div style="margin: 0 0 0 0;font-size:40px;text-decoration:underline;">Question</div><div style="margin: 25px 0 0 0;font-size:20px;">Username: <div style="color: rgb(0, 51, 0,0.75);">'+searchAllQora[i].username.username+'</div></div><div style="margin: 25px 0 0 0;font-size:20px;">Membership Number: <div style="color: rgb(0, 51, 0,0.75);">'+searchAllQora[i].firstMessage.membershipNumber+'</div></div><div style="margin: 25px 0 0 0;font-size:20px;">Message: <div style="color: rgb(0, 51, 0,0.75);">'+searchAllQora[i].firstMessage.message+'</div><div style="margin: 12.5px 0 0 0;top:0;left:12.5px;position:absolute;font-size:20px;" onclick="event.stopPropagation();">Report</div></div></div>';
                        } else if(searchAllQora[i].qoraType=="answer") {
                            questionAnswerScript=questionAnswerScript+'<div onClick="QuestionAnswer(\''+searchAllQora[i].qoraType+'\', \''+searchAllQora[i].chatGroupId+'\')" id="Chat-\''+searchAllQora[i].chatGroupId+'\'" style="" class="answers"><div style="margin: 0 0 0 0;font-size:40px;text-decoration:underline;">Answer</div><div style="margin: 25px 0 0 0;font-size:20px;">Username: <div style="color: rgb(0, 51, 0,0.75);">'+searchAllQora[i].username.username+'</div></div><div style="margin: 25px 0 0 0;font-size:20px;">Membership Number: <div style="color: rgb(0, 51, 0,0.75);">'+searchAllQora[i].firstMessage.membershipNumber+'</div></div><div style="margin: 25px 0 0 0;font-size:20px;">Message: <div style="color: rgb(0, 51, 0,0.75);">'+searchAllQora[i].firstMessage.message+'</div></div><div id="votes" style="">Votes<div style="color: rgb(0, 51, 0,0.75);">? / ?</div></div><div style="margin: 12.5px 0 0 0;top:0;left:12.5px;position:absolute;font-size:20px;" onclick="event.stopPropagation();">Report</div></div></div>';
                        }
                    } 
                }
                document.getElementById('qoraFeed').innerHTML=questionAnswerScript;
            }
            
            //Search event listener on input field
            inputField.addEventListener('input', (event) => {
                let {anArray, amount}=searchQora();
                searchAllQora=anArray;
                sortCommand();
            });
			
			//Search logic here
            function searchQora() {
                const searchText = inputField.value;
                let amount = 0;
                if (!searchText || searchText === '') {
                    return { anArray: allQora, amount: allQora.length };
                }
                const search = searchText.toLowerCase();
                let filtered = [];
                for (let i = 0; i < allQora.length; i++) {
                    const row = allQora[i];
                    if (!row) continue;
                    const col0 = String(row.firstMessage.message || '').toLowerCase();
                    if (col0.startsWith(search)) {
                        filtered.push(row);
                    }   
					const col2 = String(row.firstMessage.membershipNumber || '').toLowerCase();
					if (col2.startsWith(search)) {
						filtered.push(row);
					}  
					const col3 = String(row.username.username || '').toLowerCase();
					if (col3.startsWith(search)) {
						filtered.push(row);
					}
                }
                amount = filtered.length;
                const start = page * pageLimit - pageLimit;
                const end   = Math.min(page * pageLimit, filtered.length);
                const paged = filtered.slice(start, end);
                return { anArray: paged, amount };
            }
			
			//Logic flow when clicking the sort button
            function clickSort() {
                if(document.getElementById('sortType').innerHTML=='Sort: New') {
                    document.getElementById('sortType').innerHTML='Sort: Old';
                } else {
                    document.getElementById('sortType').innerHTML='Sort: New';
                }
                sortCommand();
            }
			
			//The actual sorting logic            
            function sortCommand() {
                const fixDate = ts => new Date(ts/*.replace(' ', 'T')*/);
                if(document.getElementById('searchQoraField').value=='') {
                    if(document.getElementById('sortType').innerHTML=='Sort: Old') {
                        allQora.sort((a, b) => fixDate(b.timestamp) - fixDate(a.timestamp));
                    } else {
                        allQora.sort((a, b) => fixDate(a.timestamp) - fixDate(b.timestamp));
                    }
                } else {
                    if(document.getElementById('sortType').innerHTML=='Sort: Old') {
                        searchAllQora.sort((a, b) => fixDate(b.timestamp) - fixDate(a.timestamp));
                    } else {
                        searchAllQora.sort((a, b) => fixDate(a.timestamp) - fixDate(b.timestamp));
                    }
                }
                pageChange(page);
            }
			
			//HTML to DOM pagination
            function pageLoad() {
                if(document.getElementById('searchQoraField').value=='') {
                    totalQora=allQora.length;
                } else {
                    totalQora=searchAllQora.length;
                }
                pageData='<div style="display:flex;flex-direction:row;flex-wrap:wrap;max-width:100%;justify-content:center;align-items:center;"><div onClick="pageChange(\'back\');"><</div>';
                if(Math.ceil(totalQora/pageLimit)<Math.ceil(page/sectionAmount)*sectionAmount) {
                    insertNew=Math.ceil(totalQora/pageLimit);
                } else {
                    insertNew=Math.ceil(page/sectionAmount)*sectionAmount;
                }
                for(i=(Math.ceil(page/sectionAmount)*sectionAmount)-sectionAmount+1;i<=insertNew;i++){
                    if(page==i) {
                        pageData=pageData+'&nbsp&nbsp<u>'+i+'</u>';
                    } else {
                        pageData=pageData+'&nbsp&nbsp<div onClick="pageChange('+i+');">'+i+'</div>';
                    }
                }
                if(totalQora==0) {
                    pageData=pageData+'&nbsp&nbsp0';
                }
                pageData=pageData+'&nbsp&nbsp<div onClick="pageChange(\'forward\');">></div></div>';
                document.getElementById('pageNumber').innerHTML=pageData;
                loadQoraFront();
            }
			
			//Altering pagination logic
            function pageChange(value) {
                if(document.getElementById('searchQoraField').value=='') {
                    totalPeople=allQora.length;
                } else {
                    totalPeople=searchAllQora.length;
                }
                if(value=='back') {
                    total=page-sectionAmount;
                    if(total==(sectionAmount-1)*-1) {
                        page=Math.ceil(totalPeople/pageLimit);
                    } else if(total<1) {
                        page=1;
                    } else {
                        page=total;
                    }
                } else if(value=='forward') {
                    total=page+sectionAmount;
                    if(total==Math.ceil(totalPeople/pageLimit)+sectionAmount) {
                        page=1;
                    } else if(total>Math.ceil(totalPeople/pageLimit)) {
                        page=Math.ceil(totalPeople/pageLimit);
                    } else {
                        page=total;
                    }
                } else {
                    page=value;
                }
                pageLoad();
            }
        </script>
    </body>
</html>
