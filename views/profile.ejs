<!DOCTYPE html>
<html>
    <head>
        <title>
            360AI
        </title>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/my_profile_style">
        <link rel="icon" href="/favicon.ico" type="image/png">
        <style>
        .navigationButtonAdmin {
			border: solid 1px transparent;
			width: 250px;
			max-width: calc( 100% - 2px );
			min-height:100px;
			display:flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			margin: 0;
			padding: 0;
			text-decoration:none;
			font-size: clamp(30px, 2vw, 40px);
			font-weight: bold;
			color: rgba(121, 255, 77,1);
			cursor:pointer;
			word-break:break-all;
		}

		.navigationButtonAdmin:hover {
			border: solid 1px;
			width: 250px;
			max-width: calc( 100% - 2px );
			min-height:100px;
			display:flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			background-color: rgba(121, 255, 77,0.125);
			margin: 0;
			padding: 0;
			text-decoration:none;
			font-size: clamp(30px, 2vw, 40px);
			font-weight: bold;
			color: rgba(121, 255, 77,1);
			border:solid 1px rgba(121, 255, 77,0.5);
			cursor:pointer;
			word-break:break-all;
		}
        </style>
    </head>
    <body>
        <div id="wholePage">
            <img src="favicon.ico" style="width:200px;margin:25px auto 0 auto;">
            <div style="max-width: calc( 100% - 10px );width:1920px;border: none;text-align:right;">v0.0.1</div>
            <hr style="border:solid 1px rgba(102, 153, 255, 0.5);width:1920px;margin:25px 0 0 0;">
			<div id="navigationMainMenu">
				<div class="navigationButton" >Enhance</div><a href="/search" class="navigationButton">Search</a><a href="/questionoranswer" class="navigationButton">Q/A</a><div class="navigationButton" >Open Field</div><a href="/options" class="navigationButton" >Options</a><a href="/admin" class="navigationButtonAdmin" style="display:none;" id="admin">Admin</a>
			</div>
            <hr style="border:solid 1px rgba(102, 153, 255, 0.5);width:1920px;margin:0 0 0 0;">
            <div style="display:flex;flex-direction:row;justify-content: center;align-items: start;flex-wrap:wrap;100%;width:1920px;max-width:100%;margin:25px 0 0 0;">
				<div id="myBot"></div>
				<div id="profileFeed" style="border:solid 1px rgba(102, 153, 255, 0.5)"></div>
            </div>
        </div>
        <div id="footer">Copyright 360AI &copy; All Rights Reserved.</div>
    </body>
    <script>
		let myEmail="<%= myEmail %>";
        let myUsername="<%= myUsername %>";
        let myBotPic="<%= myBotPic %>";
        let myMembershipNumber="<%= myMembershipNumber %>";
        let theirMembershipNumber="<%= theirMembershipNumber %>";
        let myRecruiter="<%= myRecruiter %>";
        if(myRecruiter=="Owner") {
			document.getElementById('admin').style.display="flex";
		}
        //The below code injects html into the webpage
        document.getElementById("myBot").innerHTML='<div style="width: 300px;max-width: calc( 100% - 2px );none; margin: 0 0 0 0;"><div style="max-width:100%;text-align:center;margin: 0;" class="titles">Username:</div><div style="max-width:100%;text-align:center;" class="paragraphs">'+myUsername+'</div><div style="max-width:100%;text-align:center;margin: 12.5px 0 0 0;" class="titles">Membership #:</div><div style="max-width:100%;;text-align:center;" class="paragraphs">'+myMembershipNumber+'</div><div style="max-width:100%;cursor:pointer;user-select: none;-webkit-tap-highlight-color: transparent;" onclick="loadChat();"><img src="/bots/bot ('+myBotPic+').jpg" style="width:125px;margin: 25px 0;border: solid 1px;"></div></div>';
        //When the user profile picture is clicked, it leads into a chat system
        async function loadChat() {
            let whomChat=[myMembershipNumber, myUsername, myBotPic ];
            const response = await fetch("/requestProcessing", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ whomChat, theirMembershipNumber:theirMembershipNumber }),
            });
            if(response.ok) {
                window.location.href = '/chat';
            }
        }
    </script>
</html>
