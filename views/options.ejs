<!DOCTYPE html>
<html>
    <head>
        <title>
            360AI
        </title>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/my_options_style">
        <link rel="icon" href="/favicon.ico" type="image/png">
    </head>
    <body>
        <div id="wholePage">
            <img src="favicon.ico" style="width:200px;margin:25px auto 0 auto;">
            <div style="max-width: calc( 100% - 10px );width:1920px;border: none;text-align:right;">v0.0.1</div>
            <hr style="border:solid 1px rgba(102, 153, 255, 0.5);width:1920px;margin:25px 0 0 0;">
			<div id="navigationMainMenu">
				<a href='/profile' class="navigationButton" >Profile</a><a href="/search" class="navigationButton">Search</a><a href="/questionoranswer" class="navigationButton">Q/A</a><div class="navigationButton" >Open Field</div>
			</div>
            <hr style="border:solid 1px rgba(102, 153, 255, 0.5);width:1920px;margin:0 0 0 0;">
       </div>
       <div ondblclick="logout();" style="user-select: none;-webkit-tap-highlight-color: transparent;border: solid 1px;width: 250px;max-width: calc( 100% - 2px );height:100px;display:flex;flex-direction: column;justify-content: center;align-items: center;background-color: rgba(255, 102, 102,0.125);margin: 25px auto 0 auto;padding: 0;text-decoration:none;font-size: clamp(30px, 2vw, 40px);font-weight: bold;color: rgba(255, 102, 102,1);border:solid 1px rgba(255, 102, 102,0.5);cursor:pointer;word-break:break-all;";>Logout</div>
       <div id="footer">Copyright 360AI &copy; All Rights Reserved.</div>
   </body>
   <script>
	//The logout logic
	async function logout() {
		const logout=true;
		const response = await fetch("/requestProcessing", {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({ logout }),
		});
		if (!response.ok) {
			throw new Error(`Server responded with ${response.status}`);
		} else {
			window.location.href = "/membership";
		}
	}
   </script>
</html>
