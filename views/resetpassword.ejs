<!DOCTYPE html>
<html>
    <head>
        <title>
            360AI
        </title>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/my_resetpassword_style">
        <link rel="icon" href="/favicon.ico" type="image/png">
    </head>
    <body>
        <div id="wholePage">
            <img src="favicon.ico" style="width:200px;margin:25px auto 0 auto;">
            <div style="max-width: calc( 100% - 10px );width:1920px;border: none;text-align:right;">v0.0.1</div>
            <div class="paragraphs" id="explain">
                We understand what its like to forget a password. Therefore, here is a tool to help with that!</a>
            </div>
            <div id="resetPasswordContainer">
                <div id="resetPassword">
                    <div class="titles" style="text-decoration: none;margin:0;">
                        Reset Password
                    </div>
                    <div style="font-size: 20px;margin:25px 0 25px 0;">
                        Password (6 or Greater): 
                    </div>
                    <div class="inputContainer"><input class='passwordData' type="password" style="width:200px;text-align: center;"><div class="remarkContainer"><div class="remark"><div id='checkmark'  class="checkmark"></div> <div id='crossmark' class="crossmark"></div></div></div></div>
                    <div style="font-size: 20px;margin:25px 0 25px 0;">
                        Retype Password: 
                    </div>
                    <div class="inputContainer"><input class='passwordData' type="password" style="width:200px;text-align: center;"><div class="remarkContainer"><div class="remark"><div id='checkmark2'  class="checkmark"></div> <div id='crossmark2' class="crossmark"></div></div></div></div>

                    <div class="submitButton" onClick="resetPassword();">
                        Submit
                    </div>
                </div>
            </div>
        </div>
        <div id="footer">Copyright 360AI &copy; All Rights Reserved.</div>
    </body>
    <script>
		//This is the entire reset password upon submit clicked response
        async function resetPassword() {
            const elements = document.getElementsByClassName("passwordData");
            passwordInfo=[];
            const tokenId = "<%= token %>";
            for (i=0;i<elements.length;i++) {
                passwordInfo.push(elements[i].value.trim());
            }
            try {	
                const response = await fetch("/requestProcessing", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ passwordInfo, tokenId }),
                });
                if (!response.ok) {
                    throw new Error(`Server responded with ${response.status}`);
                } else {
                    document.getElementById('crossmark').style.display='none';
                    document.getElementById('crossmark2').style.display='none';
                    document.getElementById('checkmark').style.display='none';
                    document.getElementById('checkmark2').style.display='none';
                    const result = await response.json();
                    errors = result.errors;
                    if(Array.isArray(errors) && errors.length>0) {
                        for (i=0;i<errors.length;i++) {
                            if(errors[i]=='password') {
                                document.getElementById('crossmark').style.display='grid';
                                document.getElementById('crossmark2').style.display='grid';
                                document.getElementById('checkmark').style.display='none';
                                document.getElementById('checkmark2').style.display='none';
                                break;
                            } else {
                                document.getElementById('crossmark').style.display='none';
                                document.getElementById('crossmark2').style.display='none';
                                document.getElementById('checkmark').style.display='inline-block';
                                document.getElementById('checkmark2').style.display='inline-block';
                            }
                        }
                    } else {
                        document.getElementById('crossmark').style.display='none';
                        document.getElementById('crossmark2').style.display='none';
                        document.getElementById('checkmark').style.display='inline-block';
                        document.getElementById('checkmark2').style.display='inline-block';
                    }
                }
            } catch (err) {
                console.error('Server error:', err);
            }
        }
    </script>
</html>
