        //This checks if clients are blocked. If so, excluded from loading up
        async function blockedListChecking() {
            let blockedListCheck=true;
            const response = await fetch("/requestProcessing", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ blockedListCheck }),
            });
            if(response.ok) {
                const results = await response.json();
                if(results.membershipNumbers && results.membershipNumbers.length > 0) {
                    blockedList = results.membershipNumbers;
                }
            }
        }        

		//Websocket logic connection for frontend     
        function connect() {
            if (isConnecting) return;
            if (ws && ws.readyState === WebSocket.CONNECTING) return;
            isConnecting = true;
			if (window.location.hostname === "localhost") {
				ws = new WebSocket("ws://localhost:3000");
			} else if (window.location.hostname.startsWith("10.")) {
				ws = new WebSocket(`ws://${window.location.hostname}:3000`);
			} else if (window.location.protocol === "https:") {
				ws = new WebSocket(`wss://${window.location.hostname}`); 
			} else {
				ws = new WebSocket(`ws://${window.location.hostname}`); 
			}

            ws.onclose = () => {
                isConnecting = false;
                ws = null;
            };
            ws.onerror = () => {
                isConnecting = false;
            };
            ws.onmessage = (msg) => {
                const { event, data } = JSON.parse(msg.data);
                if (handlers[event]) handlers[event](data);
            };
            ws.addEventListener("open", () => {
                //ensureWSOpen(loadChatChange);
                loadChatChange(false);
                isConnecting = false;
            });
        }
		
		//Reconnection for websocket
        function attemptReconnect() {
            setTimeout(() => {
