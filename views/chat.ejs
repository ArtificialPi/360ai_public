		//This is for custom/shortform function to show emit instead
        function emit(event, ...data) {
            const payload = JSON.stringify({ event, data });
            if (!ws || ws.readyState === WebSocket.CLOSED) {
                connect();
            }
            if (ws.readyState === WebSocket.OPEN) {
                ws.send(payload);
            }
        }
		
