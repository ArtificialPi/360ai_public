                }
                let chatPayloadLoading=[0, chatGroupId,"<%= username %>","<%= membership %>","<%= botPic %>","<%= myUsername %>","<%= myMembershipNumber %>","<%= myBotPic %>"];
                let chatPayloadInfo=[page, pageLimit, sortClick, searchingStill, clientInput, null, qora, qoraType, initialQora, firstLoad, chatAmount, false];
