							found=true;
							break;
						}
					}
                    if(found===false) {
						voteNo++;
						castVote(chatIdTemp, myMembershipNumber, voteYes, voteNo, "no");
						voteState=2;
					} else {
						if(voteState==1) {
							voteYes--;
							voteNo++;
							castVote(chatIdTemp, myMembershipNumber, voteYes, voteNo, "yes");
							castVote(chatIdTemp, myMembershipNumber, voteYes, voteNo, "no");
							voteState=0;
						} else {
							voteNo--;
							castVote(chatIdTemp, myMembershipNumber, voteYes, voteNo, "no");
							voteState=0;
						}
					}
					yesButton.textContent = "Yes: " + voteYes;
					noButton.textContent = "No: " + voteNo;				
				};   
                const reportButton = document.createElement("div");
                reportButton.className = "report";
                reportButton.appendChild(document.createTextNode("Report"));
                const blockButton = document.createElement("div");
                blockButton.className = "block";
                blockButton.appendChild(document.createTextNode("Block"));     
                blockButton.onclick = async (e) => {
                    e.stopPropagation();
                    let blockMembership = membershipNumber;
                    await blockingNow(blockMembership);
                    let chatPayloadLoading=[0, chatGroupId,"<%= username %>","<%= membership %>","<%= botPic %>","<%= myUsername %>","<%= myMembershipNumber %>","<%= myBotPic %>"];
                    let chatPayloadInfo=[page, pageLimit, sortClick, searchingStill, clientInput, null, qora, qoraType, initialQora];
                    emit("loadChat", chatPayloadLoading, chatPayloadInfo, newMessages, true, blockedList, startAi);
                }
                const messageOrderNumber = document.createElement("div");
                messageOrderNumber.className = "messageOrder";
                if(document.getElementById('sortType').innerHTML=='Sort: Old') {
                    messageOrderNumber.appendChild(document.createTextNode("Message "+messageOrder));
                } else if(document.getElementById('sortType').innerHTML=='Sort: New')  {
                    messageOrderNumber.appendChild(document.createTextNode("Message "+messageOrder));
                }
                bubble=document.createElement("div");
                bubble.className = "messageBubble";
                bubble.id = `message-${chatIdTemp}`;
                const filler = document.createElement("div");
                filler.className = "messageBubbleFiller";
                const filler2 = document.createElement("div");
                filler2.className = "messageBubbleFiller2";
                const settings2 = document.createElement("div");
                const msg2 = document.createElement("div");
                if(membershipNumber.endsWith("-AI")) {
                    settings2.className = "messageSettings2";
                    const bold2 = document.createElement("b");
                    bold2.textContent = "Replying to:";      
                    settings2.appendChild(bold2);
                    msg2.className = "aisReply";
                    msg2.textContent = targetsMsg;
                }
                const img = document.createElement("img");
                img.className = "bubbleDisplayPic";
                if(membershipNumber.endsWith("-AI")) {
					img.src = `/favicon.ico`;
				} else {
					img.src = `/bots/bot (${botId}).jpg`;
				}
                const settings = document.createElement("div");
                settings.className = "messageSettings";
                if(membershipNumber.endsWith("-AI")) {
                    const aiTitle = document.createElement("span");
                    aiTitle.style.color = "blue";
                    aiTitle.textContent = "360";
                    aiTitle.style.marginRight = "0";
                    settings.appendChild(aiTitle);
                } else {
                    settings.appendChild(document.createTextNode(author));
                }
                settings.appendChild(document.createTextNode("\u00A0"));
                const bold = document.createElement("b");
                bold.textContent = "Said:";
                settings.appendChild(bold);
                const msg = document.createElement("div");
                msg.className = "theMessage";
                msg.textContent = messageText;
                if(!membershipNumber.endsWith("-AI")) {
                    filler.appendChild(yesButton);
                    filler.appendChild(noButton);
                    filler.appendChild(reportButton);
                    filler.appendChild(blockButton);
                }
                
                if(membershipNumber.endsWith("-AI")) {
                    filler2.appendChild(settings2);
                    settings2.appendChild(msg2);
                }
                filler.appendChild(messageOrderNumber);
                
                filler.appendChild(img);
                filler.appendChild(document.createTextNode("\u00A0"));
                filler.appendChild(settings);
                
                filler.appendChild(msg);
                if(membershipNumber.endsWith("-AI")) {
                    const aiAsking = document.createElement("span");
                    aiAsking.style.marginTop = "12.5px";
                    aiAsking.style.color = "black";
                    aiAsking.textContent = "Is this correct?";
                    filler.appendChild(aiAsking)
                }
                if(membershipNumber.endsWith("-AI")) {
                    bubble.appendChild(filler2);
                }
                bubble.appendChild(filler);
                totalView.appendChild(bubble);
            }
            chatWindow.appendChild(totalView);
            if(toCheck==0&&newMessages.length>0) {
                const lc=document.querySelector("#chatWindow .messageBubble:last-child");
                scrollToMiddleFast(lc);
            } else if(toCheck==0&&!newMessages.length) {
                const cf=document.querySelector("#chatField");//console.log("fire2");
                scrollToMiddleFast(cf);            
            }  else { 
                toCheck=0;
				const el = document.getElementById("textOptions");
				scrollToMiddleFast(el);
            }               
        }
		
		//When casting a vote, this is the logic
        async function castVote(chatId, membershipNumber, voteYes, voteNo, decision) {
            const castingVote=[chatId, membershipNumber, voteState, chatGroupId, decision];
            await fetch("/requestProcessing", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ castingVote }),
            });
            emit("voteUpdate", chatGroupId, chatId, voteYes, voteNo);
        }
        
        //This checks the vote amounts for each chat message, i believe
        async function checkingVote(chatId, membershipNumber) {
            const checkingVote=[chatId, membershipNumber, chatGroupId];
            const response = await fetch("/requestProcessing", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ checkingVote }),
            });
            if(response.ok) {
                return response.json();
            }
        }
		
		//Scrolls to the middle of sent element
		function scrollToMiddle(el) {
			if (!el) return;
			const rect = el.getBoundingClientRect();
			const elementMiddle = rect.top + rect.height / 2;
			const viewportMiddle = window.innerHeight / 2;
			const alreadyCentered = Math.abs(elementMiddle - viewportMiddle) < 200;

			if (!alreadyCentered) {
				const absoluteTop = rect.top + window.pageYOffset;
				const middle = absoluteTop - (window.innerHeight / 2) + (rect.height / 2);
				window.scrollTo({
					top: middle,
					behavior: "smooth"
				});
			}                
		}
		
		//Scrolls fast to the middle of sent element
        function scrollToMiddleFast(el) {
            if (!el) return;
			const rect = el.getBoundingClientRect();
			const elementMiddle = rect.top + rect.height / 2;
			const viewportMiddle = window.innerHeight / 2;
			const alreadyCentered = Math.abs(elementMiddle - viewportMiddle) < 200;

			if (!alreadyCentered) {
				const absoluteTop = rect.top + window.pageYOffset;
				const middle = absoluteTop - (window.innerHeight / 2) + (rect.height / 2);
				window.scrollTo({
					top: middle,
					behavior: "auto"
				});
			}
        }
        
