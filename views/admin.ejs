			}		
		}
		if(selectChoice[selectChoice.length-1]=="votes/reports") {
			if(document.getElementById("lchat-votereport-"+selectDataPiece[selectChoice.length-1])) {
				document.getElementById("lchat-votereport-"+selectDataPiece[selectChoice.length-1]).remove();
			}
			
			if(document.getElementById("rchat-votereport-"+selectDataPiece[selectChoice.length-1])) {
				document.getElementById("rchat-votereport-"+selectDataPiece[selectChoice.length-1]).remove();
			}		
		}
		if(selectChoice[selectChoice.length-1]=="tokens") {
			if(document.getElementById("lchat-token-"+selectDataPiece[selectChoice.length-1])) {
				document.getElementById("lchat-token-"+selectDataPiece[selectChoice.length-1]).remove();
			}
			
			if(document.getElementById("rchat-token-"+selectDataPiece[selectChoice.length-1])) {
				document.getElementById("rchat-token-"+selectDataPiece[selectChoice.length-1]).remove();
			}
		}
		if(selectChoice[selectChoice.length-1]=="sessions") {
			if(document.getElementById("lchat-session-"+selectDataPiece[selectChoice.length-1])) {
				document.getElementById("lchat-session-"+selectDataPiece[selectChoice.length-1]).remove();
			}
			
			if(document.getElementById("rchat-session-"+selectDataPiece[selectChoice.length-1])) {
				document.getElementById("rchat-session-"+selectDataPiece[selectChoice.length-1]).remove();
			}		
		}
		document.getElementById("adminWindow").style.display="flex";
		if(choice=="chats") {
			document.getElementById("adminWindow").innerHTML = '<div id="X" onclick="removalProcedure();">X</div>' + '<div class="titles">chatGroupId: <div class="paragraphs" id="' + dataPiece + '">' + dataPiece + '</div></div>';
		}
		if(choice=="votes/reports") {
			document.getElementById("adminWindow").innerHTML = '<div id="X" onclick="removalProcedure();">X</div>' + '<div class="titles">voteReportWhoId: <div class="paragraphs" id="' + dataPiece + '">' + dataPiece + '</div></div>';
		}
		if(choice=="tokens") {
			document.getElementById("adminWindow").innerHTML = '<div id="X" onclick="removalProcedure();">X</div>' + '<div class="titles">tokenId: <div class="paragraphs" id="' + dataPiece + '">' + dataPiece + '</div></div>';
		}
		if(choice=="sessions") {
			document.getElementById("adminWindow").innerHTML = '<div id="X" onclick="removalProcedure();">X</div>' + '<div class="titles">id: <div class="paragraphs" id="' + dataPiece + '">' + dataPiece + '</div></div>';
		}
	}
	
