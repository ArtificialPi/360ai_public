	//The logic for the window when selecting a data piece
	win.addEventListener("dblclick", () => {
		if (!winStage) {
			win.style.position = "absolute";
			win.style.top = "0";
			win.style.left = "0";
			win.style.right = "0";
			win.style.bottom = "0";
			win.style.width = "auto";
			win.style.height = "auto";
			win.style.transform = "none";
			winStage = 1;
		} else {
