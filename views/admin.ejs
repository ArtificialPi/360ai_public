   <script>
	//Handlers for websocket logic
	const handlers = {};
	function on(event, fn) {
		handlers[event] = fn;
	}
	let ws;
	let isConnecting = false;
	let winStage = 0;
	const win = document.getElementById("adminWindow");
	const feed = document.getElementById("dataFeed");
	let plusClick=true;
	let dataPiece;let selectDataPiece=[];let selectChoice=[];let selectI=0;

	connect();
	//Websocket connection logic
	function connect() {
		if (isConnecting) return;
		if (ws && ws.readyState === WebSocket.CONNECTING) return;
		isConnecting = true;
		if (window.location.hostname === "localhost") {
			ws = new WebSocket("ws://localhost:3000");
		} else if (window.location.hostname.startsWith("10.")) {
			ws = new WebSocket(`ws://${window.location.hostname}:3000`);
		} else if (window.location.protocol === "https:") {
			ws = new WebSocket(`wss://${window.location.hostname}/ws`);
		} else {
			ws = new WebSocket(`ws://${window.location.hostname}/ws`);
		}
		ws.onclose = () => {
			isConnecting = false;
			ws = null;
		};
		ws.onerror = () => {
			isConnecting = false;
		};
		ws.onmessage = (msg) => {
			const { event, data } = JSON.parse(msg.data);
			if (handlers[event]) handlers[event](data);
		};
		ws.addEventListener("open", () => {
			isConnecting = false;
			ws.send(JSON.stringify({
				event: "adminJoin",
				data: { room: "Admin" }
			}));
		});
	}
	
