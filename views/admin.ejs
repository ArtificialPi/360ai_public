			}
		}
		if(selectDataPiece[selectDataPiece.length-1] && selectChoice[selectChoice.length-1]==choice) {
			if(selectChoice[selectChoice.length-1]=='sessions' && !document.getElementById("rchat-session-"+selectDataPiece[selectChoice.length-1])) {
				document.getElementById("left").innerHTML+='<div style="" onclick="selectData(\''+selectChoice[selectChoice.length-1]+'\',\''+selectDataPiece[selectDataPiece.length-1]+'\');" id="lchat-session-'+selectDataPiece[selectDataPiece.length-1]+'">'+selectDataPiece[selectDataPiece.length-1]+'</div>';
			}
		}
		selectDataPiece.push(dataPiece);
