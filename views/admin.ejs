	//The + sign in admin for choosing an option
	async function plus(choice) {
		const admin = choice;
		if(admin) {			
			const response = await fetch("/requestProcessing", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ admin }),
			});
			if (!response.ok) {
				throw new Error(`Server responded with ${response.status}`);
			} else {
				const result = await response.json();
				dataPiece = result.data || [];
			}
			plusClick=true;
			document.getElementById('option1').style.display="none";
			document.getElementById('option2').style.display="none";
			document.getElementById('option3').style.display="none";
			document.getElementById('option4').style.display="none";
			let htmlPiece='';
			for(let i=0;i<dataPiece.length;i++) {
				if(choice=="chats") {
					htmlPiece = htmlPiece + '<div style="" onclick="selectData(\''+choice+'\',\''+dataPiece[i]+'\');" id="lchat-'+dataPiece[i]+'">'+dataPiece[i]+'</div>';
				}
				if(choice=="votes/reports") {
					htmlPiece = htmlPiece + '<div style="" onclick="selectData(\''+choice+'\',\''+dataPiece[i]+'\');" id="lchat-votereport-'+dataPiece[i]+'">'+dataPiece[i]+'</div>';
				}
				if(choice=="tokens") {
					htmlPiece = htmlPiece + '<div style="" onclick="selectData(\''+choice+'\',\''+dataPiece[i]+'\');" id="lchat-token-'+dataPiece[i]+'">'+dataPiece[i]+'</div>';
				}
				if(choice=="sessions") {
					htmlPiece = htmlPiece + '<div style="" onclick="selectData(\''+choice+'\',\''+dataPiece[i]+'\');" id="lchat-session-'+dataPiece[i]+'">'+dataPiece[i]+'</div>';
				}
			}
			document.getElementById('left').innerHTML=htmlPiece;
		} else {
			if(plusClick==true) {
				plusClick=false;
				document.getElementById('option1').style.display="flex";
				document.getElementById('option2').style.display="flex";
				document.getElementById('option3').style.display="flex";
				document.getElementById('option4').style.display="flex";
			} else {
				plusClick=true;
				document.getElementById('option1').style.display="none";
				document.getElementById('option2').style.display="none";
				document.getElementById('option3').style.display="none";
				document.getElementById('option4').style.display="none";
			}
		}
	}
	
	//The data piece being selected after options picked
