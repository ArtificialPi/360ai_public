<!DOCTYPE html>
<html>
    <head>
        <title>
            360AI
        </title>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/my_search_style">
        <link rel="icon" href="/favicon.ico" type="image/png">
    </head>
    <body>
        <div id="wholePage">
            <img src="favicon.ico" style="width:200px;margin:25px auto 0 auto;">
            <div style="max-width: calc( 100% - 10px );width:1920px;border: none;text-align:right;">v0.0.1</div>
            <hr style="border:solid 1px rgba(102, 153, 255, 0.5);width:1920px;margin:25px 0 0 0;">
            <div id="navigationMainMenu">
                <a href="/profile" class="navigationButton">Profile</a><a href="/questionoranswer" class="navigationButton">Q/A</a><div class="navigationButton" >Open Field</div><a href='/options' class="navigationButton" >Options</a><div class="navigationButton" id="searchAnchor" style="display:none;"><input  style="width:200px;text-align: center;color: rgba(102, 153, 255,1);border:solid 1px rgba(102, 153, 255,1);outline: none;" value="" id="searchMembers"></div><div class="navigationButton"  onClick="clickSort();" id="sortAnchor" style="display:none;"><div id="sortType">Sort: New</div></div><div style="flex-direction: row;display:none;" id="pageNumber" class="navigationButton"></div>
            </div>
            <hr style="border:solid 1px rgba(102, 153, 255, 0.5);width:1920px;margin:0 0 0 0;">        
            <div id="infoFeed">
            <div id="infoFeedInner">
            </div>  
            </div>
        </div>
        <div id="footer">Copyright 360AI &copy; All Rights Reserved.</div>
    </body>
    <script>
		//myVar dictates the amount of "fake" profiles to generate
        myVar=200;
        realMembers=[];
        resizedParam=0;
        pageLimit=50;
        page=1;
        sectionAmount=5;
        initialLoad=0;
        let inputField = document.getElementById('searchMembers');
        
        run();
		
		//This generates a alphanumeric string 16 digits
        function generateToken(length = 16) {
            const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
            let token = '';
            for (let i = 0; i < length; i++) {
                token += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            return token;
        }
		
        const firstNames = [
            "Alice", "Bob", "Charlie", "David", "Eve", "Frank", "Grace", "Heidi", "Ivan", "Judy",
            "Kevin", "Linda", "Mike", "Nancy", "Oscar", "Pamela", "Quinn", "Rachel", "Steve", "Tina"
        ];

        const lastNames = [
            "Smith", "Jones", "Williams", "Brown", "Davis", "Miller", "Wilson", "Moore", "Taylor", "Anderson",
            "Thomas", "Jackson", "White", "Harris", "Martin", "Thompson", "Garcia", "Martinez", "Robinson", "Clark"
        ];
		
		//randomName generator using firstNames and lastNames
        fakeMembers=[];counter=0;initialSearch=0;
        function randomName() {
            return firstNames[Math.floor(Math.random() * firstNames.length)]+' '+lastNames[Math.floor(Math.random() * lastNames.length)]; 
        }
		
		//This code loads real and fake members into arrays
        async function realFakeMembers() {
            try {	
                const response = await fetch("/requestProcessing", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ realMembers }),
                });
                if (!response.ok) {
                    throw new Error(`Server responded with ${response.status}`);
                } else {
                    const result = await response.json();
                    realMembersTemp=result.realMembersPayload;
                    for(i=0;i<realMembersTemp.length;i++) {
                        let row = realMembersTemp[i];
                        realMembers.push([row[1],row[0],row[2],i+1]);
                        fakeMembers.push([row[1],row[0],row[2],i+1]);
                    }
                    
                }
            } catch (err) {
                console.error('Server error:', err);
            }
            /*
            for(i=fakeMembers.length+1;i<=myVar;i++) {    
                fakeMembers.push([randomName(),generateToken(),Math.floor(Math.random() * 50) + 1,i]);
            }
            */
        }
		
		//This is the run command in charge of activating loading members fake or not
        async function run() {
            await realFakeMembers();
            searchMemberData=[];
            for(i=0;i<fakeMembers.length;i++) {
                searchMemberData.push(fakeMembers[i]);
            }
            await blockedListChecking();
            if(realMembers.length>0) {
				document.getElementById("searchAnchor").style.display="flex";
				document.getElementById("sortAnchor").style.display="flex";
				document.getElementById("pageNumber").style.display="flex";
			}
            pageChange(page);
        };
        
        //This is a search text field event listener
        inputField.addEventListener('input', (event) => {
            let {anArray, amount}=searchMembers();
            searchMemberData=anArray;
            sortCommand();
        });
		
		//This is th splicing of array based off search text field value and pages taken into consideration
        function searchMembers() {
            const searchText = inputField.value;
            let amount = 0;
            if (!searchText || searchText === '') {
                return { anArray: fakeMembers, amount: fakeMembers.length };
            }
            const search = searchText.toLowerCase();
            let filtered = [];
            for (let i = 0; i < fakeMembers.length; i++) {
                const row = fakeMembers[i];
                if (!row) continue;

                const col0 = String(row[0] || '').toLowerCase();
                const col2 = String(row[1] || '').toLowerCase();

                if (col0.includes(search) || col2.includes(search)) {
                    filtered.push(row);
                }
            }
            amount = filtered.length;
            const start = page * pageLimit - pageLimit;
            const end   = Math.min(page * pageLimit, filtered.length);
            const paged = filtered.slice(start, end);
            return { anArray: paged, amount };
        }
		
		//When clicked, directs client to chat system
        async function loadChat(theirUsername, theirMembership, theirBotPic) {
            let whomChat=[theirMembership, theirUsername, theirBotPic];
            const response = await fetch("/requestProcessing", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ whomChat }),
            });
            if(response.ok) {
                window.location.href = '/chat';
            }
        }
		
		//When blocking a user, this is ran
        let blockSwitch=false;
        async function blockingNow(theirMembership) {
            if(!blockSwitch) {
                setTimeout(() => {
                    blockSwitch = false;
                }, 10000);
                blockSwitch=true;
                let blockWhom = theirMembership;
                const response = await fetch("/requestProcessing", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ blockWhom }),
                });
                if(response.ok) {
                    await blockedListChecking();
                    pageChange(page);
                }
            }
        }
		
		//This checks if other clients are blocked to exclude for ever using/appearing
        let blockedList = [];
        async function blockedListChecking() {
            let blockedListCheck=true;
            const response = await fetch("/requestProcessing", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ blockedListCheck }),
            });
            if(response.ok) {
                const results = await response.json();
                if(results!==null) {
                    blockedList = results.membershipNumbers;
                }
            }
        }
		
		//Writing to HTML document the members fake or not from arrays
        function loadMembers() {
            ending=0;searchData='';ending2=0;
            let blockFlag;
            if(inputField.value=='') {
                let start= page*pageLimit-pageLimit;
                let end = Math.min(page*pageLimit, fakeMembers.length);
                for(i=start;i<end;i++) {
                    blockFlag=false;
                    for(let j=0;j<blockedList.length;j++) {
                        if(fakeMembers[i][1]===blockedList[j]) {
                            blockFlag=true;
                        }
                    }
                    let hitCheck=1;
                    /*for(j=0;j<realMembers.length;j++){
                        if(realMembers[j][1]==fakeMembers[i][1]) {
                            hitCheck=1;
                        }
                    }*/
                    if(blockFlag===false) {
                        if(hitCheck) {
                            searchData=searchData+'<div class="searchContainerData" style="border:solid 1px rgba(102, 153, 255, 0.5);" id="member-'+i+'"><div class="searchTitles">Username</div><div class="searchParagraphs">'+fakeMembers[i][0]+'</div><div  class="searchTitles">Membership</div><div class="searchParagraphs">'+fakeMembers[i][1]+'</div><div onclick="loadChat(\''+fakeMembers[i][0]+'\', \''+fakeMembers[i][1]+'\', \''+fakeMembers[i][2]+'\')"><img src="/bots/bot ('+fakeMembers[i][2]+').jpg" class="searchDisplayPic"></div><div style="color:rgb(102, 153, 255, 0.75);margin: 25px 0 0 0;top:0;left:15px;position:absolute;font-size:20px;">Report</div><div id="blocking" style="" onClick="event.stopPropagation();blockingNow(\''+fakeMembers[i][1]+'\')">Block</div></div>';
                        } else {
                            searchData=searchData+'<div class="searchContainerData" style="border:solid 1px rgba(255, 77, 77,0.5);" id="member-'+i+'"><div class="searchTitles">Username</div><div class="searchParagraphs">'+fakeMembers[i][0]+'</div><div  class="searchTitles">Membership</div><div class="searchParagraphs">'+fakeMembers[i][1]+'</div><div onclick="loadChat(\''+fakeMembers[i][0]+'\', \''+fakeMembers[i][1]+'\', \''+fakeMembers[i][2]+'\')"><img src="/bots/bot ('+fakeMembers[i][2]+').jpg" class="searchDisplayPic"></div><div style="color:rgb(102, 153, 255, 0.75);margin: 25px 0 0 0;top:0;left:15px;position:absolute;font-size:20px;">Report</div><div id="blocking" style="" onClick="event.stopPropagation();blockingNow(\''+fakeMembers[i][1]+'\')">Block</div></div>';  
                        }
                    }
                }
            } else {
                let start= page*pageLimit-pageLimit;
                let end = Math.min(page*pageLimit, searchMemberData.length);
                for(i=start;i<end;i++) {
                    blockFlag=false;
                    for(let j=0;j<blockedList.length;j++) {
                        if(fakeMembers[i][1]===blockedList[j]) {
                            blockFlag=true;
                        }
                    }
                    let hitCheck=1;
                    /*for(j=0;j<realMembers.length;j++){
                        if(realMembers[j][1]==searchMemberData[i][1]) {
                            hitCheck=1;
                        }
                    }*/
                    if(blockFlag===false) {
                        if(hitCheck) {
                            searchData=searchData+'<div class="searchContainerData" style="border:solid 1px rgba(102, 153, 255, 0.5);" id="member-'+i+'"><div class="searchTitles">Username</div><div class="searchParagraphs">'+searchMemberData[i][0]+'</div><div  class="searchTitles">Membership</div><div class="searchParagraphs">'+searchMemberData[i][1]+'</div><div onclick="loadChat(\''+searchMemberData[i][0]+'\', \''+searchMemberData[i][1]+'\', \''+searchMemberData[i][2]+'\')"><img src="/bots/bot ('+searchMemberData[i][2]+').jpg" class="searchDisplayPic"></div><div style="color:rgb(102, 153, 255, 0.75);margin: 25px 0 0 0;top:0;left:15px;position:absolute;font-size:20px;">Report</div><div style="color:rgb(102, 153, 255, 0.75);margin: 25px 0 0 0;top:0;right:15px;position:absolute;font-size:20px;cursor:pointer;" onClick="event.stopPropagation();blockingNow(\''+searchMemberData[i][1]+'\')">Block</div></div>';
                        } else {
                            searchData=searchData+'<div class="searchContainerData" style="border:solid 1px rgba(255, 77, 77,0.5);" id="member-'+i+'"><div class="searchTitles">Username</div><div class="searchParagraphs">'+searchMemberData[i][0]+'</div><div  class="searchTitles">Membership</div><div class="searchParagraphs">'+searchMemberData[i][1]+'</div><div onclick="loadChat(\''+searchMemberData[i][0]+'\', \''+searchMemberData[i][1]+'\', \''+searchMemberData[i][2]+'\')"><img src="/bots/bot ('+searchMemberData[i][2]+').jpg" class="searchDisplayPic"></div><div style="color:rgb(102, 153, 255, 0.75);margin: 25px 0 0 0;top:0;left:15px;position:absolute;font-size:20px;">Report</div><div style="color:rgb(102, 153, 255, 0.75);margin: 25px 0 0 0;top:0;right:15px;position:absolute;font-size:20px;cursor:pointer;" onClick="event.stopPropagation();blockingNow(\''+searchMemberData[i][1]+'\');">Block</div></div>';  
                        }
                    }
                }
            }
            document.getElementById("infoFeedInner").innerHTML=searchData;
        }
		
		//Sort command clicking adjustments
        function clickSort() {
            if(document.getElementById('sortType').innerHTML=='Sort: New') {
                document.getElementById('sortType').innerHTML='Sort: Old';
            } else {
                document.getElementById('sortType').innerHTML='Sort: New';
            }
            sortCommand();
        }
		
		//The actual sorting of the members array, fake or not
        function sortCommand() {
            if(document.getElementById('searchMembers').value=='') {
                if(document.getElementById('sortType').innerHTML=='Sort: Old') {
                    fakeMembers.sort((a, b) => b[3] - a[3]);
                } else {
                    fakeMembers.sort((a, b) => a[3] - b[3]);
                }
            } else {
                if(document.getElementById('sortType').innerHTML=='Sort: Old') {
                    searchMemberData.sort((a, b) => b[3] - a[3]);
                } else {
                    searchMemberData.sort((a, b) => a[3] - b[3]);
                }
            }
            pageChange(page);
        }
		
		//The pagination number calculation and written to HTML document
        function pageLoad() {
            if(document.getElementById('searchMembers').value=='') {
                totalPeople=fakeMembers.length;
            } else {
                totalPeople=searchMemberData.length;
            }
            pageData='<div style="display:flex;flex-direction:row;flex-wrap:wrap;max-width:100%;justify-content:center;align-items:center;"><div onClick="pageChange(\'back\');"><</div>';
            if(Math.ceil(totalPeople/pageLimit)<Math.ceil(page/sectionAmount)*sectionAmount) {
                insertNew=Math.ceil(totalPeople/pageLimit);
            } else {
                insertNew=Math.ceil(page/sectionAmount)*sectionAmount;
            }
            for(i=(Math.ceil(page/sectionAmount)*sectionAmount)-sectionAmount+1;i<=insertNew;i++){
                if(page==i) {
                    pageData=pageData+'&nbsp&nbsp<u>'+i+'</u>';
                } else {
                    pageData=pageData+'&nbsp&nbsp<div onClick="pageChange('+i+');">'+i+'</div>';
                }
            }
            if(totalPeople==0) {
                pageData=pageData+'&nbsp&nbsp0';
            }
            pageData=pageData+'&nbsp&nbsp<div onClick="pageChange(\'forward\');">></div></div>';
            document.getElementById('pageNumber').innerHTML=pageData;
            initialLoad=0;
            loadMembers();
        }
		
		//The pagination response when clicking a page number. To shift and such
        function pageChange(value) {
            if(document.getElementById('searchMembers').value=='') {
                totalPeople=fakeMembers.length;
            } else {
                totalPeople=searchMemberData.length;
            }
            if(value=='back') {
                total=page-sectionAmount;
                if(total==(sectionAmount-1)*-1) {
                    page=Math.ceil(totalPeople/pageLimit);
                } else if(total<1) {
                    page=1;
                } else {
                    page=total;
                }
            } else if(value=='forward') {
                total=page+sectionAmount;
                if(total==Math.ceil(totalPeople/pageLimit)+sectionAmount) {
                    page=1;
                } else if(total>Math.ceil(totalPeople/pageLimit)) {
                    page=Math.ceil(totalPeople/pageLimit);
                } else {
                    page=total;
                }
            } else {
                page=value;
            }
            pageLoad();
        }
    </script>
</html>
